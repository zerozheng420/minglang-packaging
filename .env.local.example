# Resend API Key (get yours at https://resend.com)
# Free tier: 100 emails/day
# MUST be set in Vercel project settings -> Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where inquiry emails are delivered (defaults to 1703058063@qq.com)
RECIPIENT_EMAIL=1703058063@qq.com

# Sender address. Only use noreply@minglangpackaging.com after verifying the
# domain in Resend (add DKIM/SPF DNS records). Until then, use:
#   RESEND_FROM="Minglang Packaging <onboarding@resend.dev>"
RESEND_FROM="Minglang Packaging <noreply@minglangpackaging.com>"

# Site URL (set this in production)
NEXT_PUBLIC_SITE_URL=https://minglangpackaging.com
